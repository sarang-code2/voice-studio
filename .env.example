# Script generation backend: "anthropic" (default, needs a funded Anthropic
# console account) or "ollama" (free, runs locally -- needs `ollama serve`
# running and a model pulled, e.g. `ollama pull llama3.2`). Local models
# follow the schema/pedagogy rules less reliably; review the script before
# recording.
LLM_BACKEND=anthropic

# Only used when LLM_BACKEND=anthropic. Get one at console.anthropic.com
# (separate account/billing from a Claude Code subscription).
ANTHROPIC_API_KEY=

# Only used when LLM_BACKEND=ollama.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Path to your voice reference clip (5-15s, clean, single speaker)
VOICE_REFERENCE_PATH=assets/voice_reference/sample.wav

# torch device for Chatterbox: mps (Apple Silicon), cuda, or cpu
TTS_DEVICE=mps
